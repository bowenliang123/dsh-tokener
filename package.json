{
  "name": "dsh-tokener",
  "version": "0.1.0",
  "description": "Tokener.ai gateway LLM adapter (Anthropic Messages protocol) for the DeepSeek Harness LLM seam",
  "author": "bowenliang123",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bowenliang123/dsh-tokener.git"
  },
  "homepage": "https://github.com/bowenliang123/dsh-tokener",
  "bugs": {
    "url": "https://github.com/bowenliang123/dsh-tokener/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc -p tsconfig.tests.json",
    "test": "pnpm run typecheck && vitest run --coverage",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "verify": "pnpm run lint && pnpm run test && pnpm run build",
    "release": "npm publish"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "llm",
    "provider",
    "tokener",
    "anthropic",
    "gateway"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "eventsource-parser": "^3.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-attachment": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-brand": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-util-values": ">=0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-brand": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-credentials": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-credentials-local": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-fs": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-launch-environment": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-settings-file": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-timeout": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-util-values": "0.1.2-alpha.5",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint-plugin-sonarjs": "^4.2.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  }
}
